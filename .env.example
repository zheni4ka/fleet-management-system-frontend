# Скопіюйте цей файл у .env і заповніть значення. Файл .env не потрапляє в git.

# Адреса API. Використовується лише на сервері Next.js (серверні компоненти, BFF-обробники /api/session/* та /api/proxy/*).
# Браузер ніколи не звертається до API напряму й не бачить токен доступу.
API_BASE_URL=http://localhost:5196

# Ключ Google Maps Embed API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Вхід через Microsoft Entra ID (OIDC, authorization code + PKCE через BFF).
# Залиште всі чотири порожніми, щоб вимкнути кнопку корпоративного входу; часткове налаштування є помилкою.
# OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# APP_BASE_URL — публічна адреса фронтенду; redirect URI у реєстрації застосунку: <APP_BASE_URL>/api/session/sso/callback
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_BASE_URL=
